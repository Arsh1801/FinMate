# ==============================================================================
# FinMate Platform Environment Configuration Template
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Defaults to in-memory H2 with MySQL syntax emulation in dev)
# For production MySQL 8 instance:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finmate_db
DB_USER=finmate
DB_PASSWORD=CHANGE_ME

# Spring Security & JWT Configuration
# Note: In production, generate a secure 512-bit HS512 secret key
JWT_SECRET=REPLACE_WITH_A_SECURE_SECRET
JWT_EXPIRATION_MS=1800000
REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External Currency Exchange Rate API (Optional key, public rate endpoints fallback smoothly)
EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_API_KEY=

# Mail Server Configuration (For password reset & budget alert notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@finmate.local
